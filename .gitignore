# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# ...but the frontend offline bundle IS committed (ships for pip/npx, works offline).
# Only the JS bundle is tracked; the sourcemap is regenerated locally by `npm run build`.
!frontend/dist/
frontend/dist/*.map

# MCP example outputs (generated evidence images)
examples/mcp/inspect_out/
examples/mcp/parts_out/
examples/mcp/hero_out/

# The web/ Pages site: index.html is tracked; the bundle + copied vendor decoders are
# build artifacts (CI rebuilds them). The source vendor lives in frontend/vendor.
web/meshvault-viewer.js
web/meshvault-viewer.js.map
web/vendor/

# ===========================
# Virtual environments
# ===========================
.venv/
.venv-mcp/
venv/
env/

# ===========================
# Testing
# ===========================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ===========================
# IDE / Editor
# ===========================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ===========================
# Node / NPM
# ===========================
node_modules/
npm-debug.log*
*.tgz

# ===========================
# Project-specific
# ===========================

# Untracked test assets (3D files, archives)
untracked/

# Temporary conversion outputs
*.converted.obj

# Poetry lock is committed, but not the cache
# poetry.lock  # (we DO commit this)
